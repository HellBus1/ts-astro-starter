    "astro": "^7.4.2",
    "typescript": "^5.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@playwright/test": "^1.51.0",
    "eslint": "^9.22.0",
    "eslint-plugin-astro": "^1.3.1",
    "prettier": "^3.5.3",
    "prettier-plugin-astro": "^1.1.2",
    "typescript-eslint": "^8.26.0",
    "vitest": "^3.0.8"
  }
}
