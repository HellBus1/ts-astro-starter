{
  "name": "ts-astro-starter",
  "type": "module",
  "version": "1.0.0",
  "description": "Production-ready, accessible, and high-performance Astro + TypeScript starter template.",
  "license": "MIT",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
