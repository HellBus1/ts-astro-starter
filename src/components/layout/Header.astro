---
import { siteConfig } from '../../config/site';
import { navigationConfig } from '../../config/navigation';
import Container from '../ui/Container.astro';
import ThemeToggle from '../ui/ThemeToggle.astro';

const currentPath = Astro.url.pathname;
const navItems = navigationConfig.header;

function isActive(href: string): boolean {
  if (href === '/') {
    return currentPath === '/';
  }
  return currentPath.startsWith(href);
}
---

<header class="header">
  <Container size="xl">
    <div class="header__inner">
      <!-- Site Branding -->
      <a href="/" class="header__brand" aria-label={`${siteConfig.name} Home`}>
        <svg
          class="header__logo-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242"></path>
          <path d="M12 12v9"></path>
          <path d="m8 17 4 4 4-4"></path>
        </svg>
        <span class="header__brand-name">{siteConfig.name}</span>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="header__nav" aria-label="Main Navigation">
        <ul class="header__nav-list">
          {navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  'header__nav-link',
                  isActive(item.href) ? 'header__nav-link--active' : '',
                ]}
                aria-current={isActive(item.href) ? 'page' : undefined}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener noreferrer' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Actions: Theme Toggle & Mobile Menu Button -->
      <div class="header__actions">
        <ThemeToggle />

        <button
          type="button"
          id="mobile-menu-toggle"
          class="header__mobile-toggle"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Toggle navigation menu"
        >
          <svg
            class="header__menu-icon icon-open"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="4" x2="20" y1="12" y2="12"></line>
            <line x1="4" x2="20" y1="6" y2="6"></line>
            <line x1="4" x2="20" y1="18" y2="18"></line>
          </svg>
          <svg
            class="header__menu-icon icon-close"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M18 6 6 18"></path>
            <path d="m6 6 12 12"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Drawer Menu -->
    <div id="mobile-menu" class="header__mobile-menu" hidden>
      <nav aria-label="Mobile Navigation">
        <ul class="header__mobile-list">
          {navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  'header__mobile-link',
                  isActive(item.href) ? 'header__mobile-link--active' : '',
                ]}
                aria-current={isActive(item.href) ? 'page' : undefined}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener noreferrer' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </Container>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: var(--color-bg-canvas);
    border-bottom: 1px solid var(--color-border-subtle);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition:
      background-color var(--transition-base),
      border-color var(--transition-base);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4rem;
  }

  .header__brand {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-main);
    text-decoration: none;
  }

  .header__brand:hover {
    color: var(--color-brand-primary);
    text-decoration: none;
  }

  .header__logo-icon {
    width: 1.5rem;
    height: 1.5rem;
    color: var(--color-brand-primary);
  }

  .header__nav {
    display: none;
  }

  @media (min-width: 768px) {
    .header__nav {
      display: block;
    }
  }

  .header__nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    list-style: none;
  }

  .header__nav-link {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-muted);
    transition: color var(--transition-fast);
  }

  .header__nav-link:hover {
    color: var(--color-text-main);
    text-decoration: none;
  }

  .header__nav-link--active {
    color: var(--color-brand-primary);
    font-weight: var(--font-weight-semibold);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .header__mobile-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: var(--space-1);
    background: transparent;
    color: var(--color-text-main);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-lg);
    cursor: pointer;
  }

  .header__mobile-toggle:hover {
    background-color: var(--color-bg-subtle);
  }

  .header__menu-icon {
    width: 1.25rem;
    height: 1.25rem;
  }

  .icon-close {
    display: none;
  }

  .header__mobile-toggle[aria-expanded='true'] .icon-open {
    display: none;
  }

  .header__mobile-toggle[aria-expanded='true'] .icon-close {
    display: block;
  }

  @media (min-width: 768px) {
    .header__mobile-toggle {
      display: none;
    }
  }

  /* Mobile Dropdown Menu */
  .header__mobile-menu {
    border-top: 1px solid var(--color-border-subtle);
    padding-block: var(--space-4);
  }

  .header__mobile-menu[hidden] {
    display: none;
  }

  .header__mobile-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    list-style: none;
  }

  .header__mobile-link {
    display: block;
    padding: var(--space-2) var(--space-3);
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-muted);
    border-radius: var(--radius-md);
  }

  .header__mobile-link:hover {
    background-color: var(--color-bg-subtle);
    color: var(--color-text-main);
    text-decoration: none;
  }

  .header__mobile-link--active {
    color: var(--color-brand-primary);
    background-color: var(--color-brand-primary-subtle);
    font-weight: var(--font-weight-semibold);
  }

  @media (min-width: 768px) {
    .header__mobile-menu {
      display: none !important;
    }
  }
</style>

<script>
  function setupMobileMenu() {
    const toggle = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-menu');

    if (!toggle || !menu) return;

    toggle.addEventListener('click', () => {
      const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isExpanded));
      if (isExpanded) {
        menu.setAttribute('hidden', '');
      } else {
        menu.removeAttribute('hidden');
      }
    });
  }

  setupMobileMenu();
  document.addEventListener('astro:after-swap', setupMobileMenu);
</script>
