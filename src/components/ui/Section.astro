---
import type { HTMLAttributes } from 'astro/types';

export interface Props extends HTMLAttributes<'section'> {
  spacing?: 'none' | 'sm' | 'md' | 'lg';
  surface?: 'default' | 'surface' | 'subtle' | 'accent';
  id?: string;
  class?: string;
}

const { spacing = 'md', surface = 'default', id, class: className = '', ...rest } = Astro.props;
---

<section
  id={id}
  class:list={['section', `section--spacing-${spacing}`, `section--surface-${surface}`, className]}
  {...rest}
>
  <slot />
</section>

<style>
  .section {
    position: relative;
    width: 100%;
  }

  /* Spacing Variants */
  .section--spacing-none {
    padding-block: 0;
  }

  .section--spacing-sm {
    padding-block: var(--space-8);
  }

  .section--spacing-md {
    padding-block: var(--space-12);
  }

  .section--spacing-lg {
    padding-block: var(--space-20);
  }

  @media (min-width: 768px) {
    .section--spacing-md {
      padding-block: var(--space-16);
    }

    .section--spacing-lg {
      padding-block: var(--space-24);
    }
  }

  /* Surface Variants */
  .section--surface-default {
    background-color: transparent;
  }

  .section--surface-surface {
    background-color: var(--color-bg-surface);
    border-block: 1px solid var(--color-border-subtle);
  }

  .section--surface-subtle {
    background-color: var(--color-bg-subtle);
  }

  .section--surface-accent {
    background-color: var(--color-brand-primary-subtle);
  }
</style>
