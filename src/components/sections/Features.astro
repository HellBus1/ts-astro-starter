---
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';

interface FeatureItem {
  title: string;
  description: string;
  icon: string;
}

const features: FeatureItem[] = [
  {
    title: 'Zero-JS by Default',
    description:
      'Compiles to pure, lightweight HTML and CSS. Zero framework client runtime is shipped unless explicitly opted into.',
    icon: 'zap',
  },
  {
    title: 'Strict TypeScript',
    description:
      'Configured with strict type checking, typesafe component props, and robust interfaces to eliminate runtime errors.',
    icon: 'shield',
  },
  {
    title: 'Design Tokens & Zero-FOUC',
    description:
      'Pure CSS custom properties for effortless brand adaptation. Supports instant dark mode without flash of unstyled content.',
    icon: 'palette',
  },
  {
    title: 'Accessible by Design',
    description:
      'Engineered with semantic landmarks, keyboard focus management, SkipLink, and WCAG AA contrast compliance.',
    icon: 'eye',
  },
  {
    title: 'Astro Content Layer',
    description:
      'Manage blogs, guides, or documentation effortlessly using modern Content Collections and type-safe frontmatter schemas.',
    icon: 'file-text',
  },
  {
    title: 'Full Testing Coverage',
    description:
      'Equipped with Vitest for unit testing and Playwright for real-browser end-to-end verification out of the box.',
    icon: 'check-circle',
  },
];
---

<Section id="features" surface="surface" spacing="lg">
  <Container size="xl">
    <div class="features__header">
      <h2 class="features__title">Engineered for Production Excellence</h2>
      <p class="features__subtitle">
        Everything you need to launch reliable, accessible, and ultra-fast web experiences without
        overengineering.
      </p>
    </div>

    <div class="features__grid">
      {features.map((feature) => (
        <div class="feature-card">
          <div class="feature-card__icon-wrapper">
            {feature.icon === 'zap' && (
              <svg
                class="feature-card__icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
              </svg>
            )}
            {feature.icon === 'shield' && (
              <svg
                class="feature-card__icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10" />
              </svg>
            )}
            {feature.icon === 'palette' && (
              <svg
                class="feature-card__icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="13.5" cy="6.5" r=".5" fill="currentColor" />
                <circle cx="17.5" cy="10.5" r=".5" fill="currentColor" />
                <circle cx="8.5" cy="7.5" r=".5" fill="currentColor" />
                <circle cx="6.5" cy="12.5" r=".5" fill="currentColor" />
                <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z" />
              </svg>
            )}
            {feature.icon === 'eye' && (
              <svg
                class="feature-card__icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z" />
                <circle cx="12" cy="12" r="3" />
              </svg>
            )}
            {feature.icon === 'file-text' && (
              <svg
                class="feature-card__icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" />
                <path d="M14 2v4a2 2 0 0 0 2 2h4" />
                <path d="M10 9H8" />
                <path d="M16 13H8" />
                <path d="M16 17H8" />
              </svg>
            )}
            {feature.icon === 'check-circle' && (
              <svg
                class="feature-card__icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                <path d="m9 11 3 3L22 4" />
              </svg>
            )}
          </div>

          <h3 class="feature-card__title">{feature.title}</h3>
          <p class="feature-card__description">{feature.description}</p>
        </div>
      ))}
    </div>
  </Container>
</Section>

<style>
  .features__header {
    text-align: center;
    max-width: 44rem;
    margin-inline: auto;
    margin-bottom: var(--space-12);
  }

  .features__title {
    font-size: var(--font-size-2xl);
    color: var(--color-text-main);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-3);
  }

  @media (min-width: 640px) {
    .features__title {
      font-size: var(--font-size-3xl);
    }
  }

  .features__subtitle {
    font-size: var(--font-size-base);
    color: var(--color-text-muted);
    line-height: var(--line-height-normal);
  }

  .features__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .features__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .features__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-8);
    }
  }

  .feature-card {
    padding: var(--space-6);
    background-color: var(--color-bg-canvas);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-xl);
    transition:
      border-color var(--transition-fast),
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .feature-card:hover {
    border-color: var(--color-brand-primary);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .feature-card__icon-wrapper {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-lg);
    background-color: var(--color-brand-primary-subtle);
    color: var(--color-brand-primary);
    margin-bottom: var(--space-4);
  }

  .feature-card__icon {
    width: 1.5rem;
    height: 1.5rem;
  }

  .feature-card__title {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-main);
    margin-bottom: var(--space-2);
  }

  .feature-card__description {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    line-height: var(--line-height-relaxed);
  }
</style>
