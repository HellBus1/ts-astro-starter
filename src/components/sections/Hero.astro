---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import { siteConfig } from '../../config/site';

export interface Props {
  badge?: string;
  title?: string;
  description?: string;
}

const {
  badge = '⚡ Production-Ready Astro Starter',
  title = 'Build Modern, Blazing-Fast Websites with Astro & TypeScript',
  description = 'A meticulously crafted starter template engineered for peak performance, pristine accessibility, zero runtime bloat, and delightful developer experience.',
} = Astro.props;
---

<section class="hero">
  <Container size="lg">
    <div class="hero__content">
      {badge && <div class="hero__badge">{badge}</div>}

      <h1 class="hero__title">{title}</h1>

      <p class="hero__description">{description}</p>

      <div class="hero__actions">
        <Button variant="primary" size="lg" href="#features">
          Explore Features
          <svg
            class="hero__btn-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </Button>

        {siteConfig.socials.github && (
          <Button
            variant="outline"
            size="lg"
            href={siteConfig.socials.github}
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg
              class="hero__btn-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
              <path d="M9 18c-4.51 2-5-2-7-2"></path>
            </svg>
            GitHub
          </Button>
        )}
      </div>
    </div>
  </Container>
</section>

<style>
  .hero {
    padding-block: var(--space-16) var(--space-20);
    text-align: center;
  }

  @media (min-width: 768px) {
    .hero {
      padding-block: var(--space-24) var(--space-24);
    }
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 52rem;
    margin-inline: auto;
  }

  .hero__badge {
    display: inline-flex;
    align-items: center;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    color: var(--color-brand-primary);
    background-color: var(--color-brand-primary-subtle);
    border: 1px solid var(--color-brand-primary-subtle);
    margin-bottom: var(--space-6);
  }

  .hero__title {
    font-size: var(--font-size-3xl);
    line-height: var(--line-height-tight);
    color: var(--color-text-main);
    letter-spacing: -0.03em;
    margin-bottom: var(--space-5);
  }

  @media (min-width: 640px) {
    .hero__title {
      font-size: var(--font-size-5xl);
    }
  }

  .hero__description {
    font-size: var(--font-size-lg);
    color: var(--color-text-muted);
    line-height: var(--line-height-relaxed);
    max-width: 44rem;
    margin-bottom: var(--space-8);
  }

  @media (min-width: 640px) {
    .hero__description {
      font-size: var(--font-size-xl);
    }
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
  }

  .hero__btn-icon {
    width: 1.125rem;
    height: 1.125rem;
  }
</style>
