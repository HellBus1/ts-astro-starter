---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Section from '../../components/ui/Section.astro';
import { getCollection } from 'astro:content';
import { formatDate, toISODate } from '../../utils/date';

const posts = await getCollection('blog', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

posts.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());
---

<BaseLayout
  title="Blog & Articles"
  description="Insights, tutorials, and architectural best practices for modern web development with Astro."
>
  <Section spacing="lg">
    <Container size="md">
      <header class="blog-header">
        <h1 class="blog-header__title">Blog & Articles</h1>
        <p class="blog-header__description">
          Insights, guides, and architectural best practices for building scalable web apps with
          Astro and TypeScript.
        </p>
      </header>

      <div class="blog-list">
        {posts.length === 0 ? (
          <p class="blog-list__empty">No posts found. Check back soon!</p>
        ) : (
          posts.map((post) => (
            <article class="blog-card">
              <div class="blog-card__meta">
                <time datetime={toISODate(post.data.publishDate)} class="blog-card__date">
                  {formatDate(post.data.publishDate)}
                </time>
                {post.data.tags.length > 0 && (
                  <div class="blog-card__tags">
                    {post.data.tags.map((tag) => (
                      <span class="blog-card__tag">#{tag}</span>
                    ))}
                  </div>
                )}
              </div>

              <h2 class="blog-card__title">
                <a href={`/blog/${post.id}`} class="blog-card__link">
                  {post.data.title}
                </a>
              </h2>

              <p class="blog-card__description">{post.data.description}</p>

              <a href={`/blog/${post.id}`} class="blog-card__read-more">
                Read article &rarr;
              </a>
            </article>
          ))
        )}
      </div>
    </Container>
  </Section>
</BaseLayout>

<style>
  .blog-header {
    text-align: center;
    margin-bottom: var(--space-12);
  }

  .blog-header__title {
    font-size: var(--font-size-3xl);
    color: var(--color-text-main);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-3);
  }

  @media (min-width: 640px) {
    .blog-header__title {
      font-size: var(--font-size-4xl);
    }
  }

  .blog-header__description {
    font-size: var(--font-size-base);
    color: var(--color-text-muted);
    max-width: 38rem;
    margin-inline: auto;
    line-height: var(--line-height-normal);
  }

  .blog-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .blog-list__empty {
    text-align: center;
    padding-block: var(--space-12);
    color: var(--color-text-muted);
  }

  .blog-card {
    padding: var(--space-6);
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-xl);
    transition:
      border-color var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .blog-card:hover {
    border-color: var(--color-brand-primary);
    box-shadow: var(--shadow-sm);
  }

  .blog-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .blog-card__date {
    font-size: var(--font-size-xs);
    color: var(--color-text-subtle);
  }

  .blog-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .blog-card__tag {
    font-size: var(--font-size-xs);
    color: var(--color-brand-primary);
    background-color: var(--color-brand-primary-subtle);
    padding: 0.1rem 0.4rem;
    border-radius: var(--radius-sm);
  }

  .blog-card__title {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-main);
    margin-bottom: var(--space-2);
    line-height: var(--line-height-snug);
  }

  .blog-card__link {
    color: inherit;
    text-decoration: none;
  }

  .blog-card__link:hover {
    color: var(--color-brand-primary);
    text-decoration: none;
  }

  .blog-card__description {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    line-height: var(--line-height-relaxed);
    margin-bottom: var(--space-4);
  }

  .blog-card__read-more {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-brand-primary);
  }

  .blog-card__read-more:hover {
    color: var(--color-brand-primary-hover);
    text-decoration: underline;
  }
</style>
